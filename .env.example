# Copy to `.env.local`. Next.js loads that file automatically.
# Use the Project URL and anon / publishable key from Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# 서버 결제 저장용. Vercel Environment Variables에 반드시 등록하세요. (브라우저 노출 금지)
# 별칭: SUPABASE_SECRET_KEY, SUPABASE_KEY, SUPABASE_SERVICE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Toss Payments
# 위젯(클라이언트): 반드시 NEXT_PUBLIC_ 접두사. Vercel Environment Variables에 동일 이름으로 등록하세요.
# 결제 승인(서버): TOSS_SECRET_KEY. 클라이언트에 노출하지 마세요.
# 둘 다 없으면 낙찰 결제는 데모 모드로 동작합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_YOUR_WIDGET_CLIENT_KEY
TOSS_SECRET_KEY=test_gsk_YOUR_SECRET_KEY

# 팝빌 전자세금계산서 (없으면 콘솔/DB 임시 기록으로 우회)
# 오타 별칭 POPBILL_SECRECT_KEY 도 동일하게 인식합니다.
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_SECRECT_KEY=

# 솔라피 카카오 알림톡 / SMS (없으면 [Notification Mock] 로그만 남기고 통과)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_PFID=
SOLAPI_KAKAO_TEMPLATE_ID=
SOLAPI_DEFAULT_TO=
CRON_SECRET=

# Sentry 에러 모니터링 (없으면 [Sentry Fallback] 개발 로거로 우회)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# API Rate Limit (미설정 시 운영 1분 60회, 개발 1분 300회)
RATE_LIMIT_MAX=

# 카카오 로그인 (Supabase Kakao provider)
# 카카오 개발자 콘솔 Redirect URI (KOE202/URI 불일치 방지):
#   {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
# 예: https://jatmkycmvboyniafqzeg.supabase.co/auth/v1/callback
# KOE205 (설정하지 않은 동의 항목 account_email):
#   카카오 로그인 > 동의 항목에서 이메일을 사용으로 두거나,
#   앱 설정 > 비즈니스에서 개인/사업자 등록 후 account_email을 활성화하세요.
#   Supabase Authentication > Providers > Kakao 에서 Allow users without an email 도 켜 두세요.

# 네이버 로그인 (Supabase 기본 프로바이더 없음 → 자체 OAuth 콜백)
# 네이버 앱 콜백 URL: {ORIGIN}/api/auth/naver/callback
NAVER_CLIENT_ID=y4kW0zBJCewRYyWibzH2
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET_HERE
